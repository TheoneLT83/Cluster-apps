      "type": "bool",
      "default": true,
      "hidden": true
    },
    {
      "key": "hudData",
      "label": "Between the turn signals",
      "type": "choice",
      "default": "off",
      "options": [
        [
          "off",
          "None"
        ],
        [
          "ev",
          "Electric range"
        ],
        [
          "temps",
          "Oil and coolant"
        ]
      ],
