{
  "id": "robertn_waze_cluster",
  "title": "Cluster functions",
  "description": "The phone's map on the instrument cluster and the HUD (CarPlay and Android Auto), with the HUD map's size, place and brightness; turn signals, the gear, the real speed and one more reading on the HUD: electric range with eDrive power, or oil and coolant",
  "version": "0.8.0",
  "vendor": "Robert Nisipeanu",
  "loggingId": "WOCA",
  "memoryKB": 153600,
  "cpuLimit": 50,
  "signals": {
    "de.bmw.infrastructure.VehicleInformation": {
      "DataPowerTrain2": "s",
      "statusGearboxDrive": "s",
      "_optional": "the gear on the HUD"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": "HMI_CID",
      "currentDisplayLanguage": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "the real speed on the HUD"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "_optional": "oil and coolant on the HUD, the electric range"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ],
      "_optional": "eDrive power and the electric range on the HUD (the battery unit)"
    }
  },
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Cluster functions",
      "buttons": [
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "settings": [
