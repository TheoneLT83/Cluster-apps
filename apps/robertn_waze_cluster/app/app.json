{
  "id": "robertn_waze_cluster",
  "title": "Cluster functions",
  "description": "The phone's map on the instrument cluster and the HUD (CarPlay and Android Auto), with the HUD map's size, place and brightness; turn signals, the gear, the real speed and one more reading on the HUD: electric range, oil and coolant, boost, power and torque, or engine speed",
  "version": "0.9.18",
  "vendor": "Robert Nisipeanu",
  "loggingId": "WOCA",
  "memoryKB": 153600,
  "cpuLimit": 50,
  "signals": {
    "de.bmw.infrastructure.VehicleInformation": {
      "DataPowerTrain2": "s",
      "statusGearboxDrive": "s",
      "_optional": "the gear on the HUD"
    },
    "de.bmw.infotainment.hmi.hmicontext.HMIContext": {
      "_instances": "HMI_CID",
      "currentDisplayLanguage": "rs"
    },
    "de.bmw.infotainment.vehicle.Vehicle2": {
      "statusCarSpeed2": "rs",
      "_optional": "the real speed on the HUD"
    },
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "_optional": "oil and coolant on the HUD, the electric range"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusActualValueTorque2": "rs",
      "statusSwitchDriveDynamicSport2": "rs",
      "_optional": "boost, power and torque on the HUD"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "dataDisplayGearbox": "s",
      "_optional": "S or M beside the gear on the HUD"
    },
    "de.bmw.body.Light": {
      "_instances": "1",
      "StatusFunctionsIndicators": "s",
      "_optional": "the turn signals on the HUD"
    },
    "de.bmw.dass.driverassistanceapplications.TrafficSignDisplayControl": {
      "_optional": "the green light alert (BMW's own traffic-light display)",
      "displayForesight": "s"
    },
    "de.bmw.environmentalmodel.TrafficLightRecognitionFrontCameraLegacy": {
      "_optional": "the green light alert (the camera's traffic lights)",
      "_broadcasts": [
        "RecognitionTrafficLightCamera"
      ]
    },
    "de.bmw.infotainment.vehicle.Vehicle": {
      "statusDayNightChangeOver": "rs",
      "_optional": "the HUD dimmer at night"
    }
  },
