{
  "name": "robertn_waze_cluster",
  "version": "0.7.0",
  "description": "The phone's map on the instrument cluster and the HUD (CarPlay and Android Auto), with the HUD map's size, place and brightness, turn signals and the gear on the HUD",
  "main": "javascript/app.js",
  "private": false,
  "author": "Robert Nisipeanu",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=8.7.0"
  },
  "oapAppSettings": {
    "maxDiskUsage": 20971520,
    "cpuLimit": 50,
    "memoryThresholdKB": 153600,
    "priority": "PRIO_LOW",
    "visibility": "FOREGROUND",
    "latencyClass": "FOREGROUND",
    "loggingId": "WOCA",
    "userLoginRequired": false,
    "backgroundPriority": 200,
    "someipManifest": "manifest.json"
  },
  "mguLocalOnly": true,
  "mguAppStartType": "autostart"
}
